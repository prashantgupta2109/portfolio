<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 750" width="1200" height="750">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2563eb" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0.8" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)" />
  <rect width="100%" height="100%" fill="url(#grid)" />

  <!-- Browser Window Mockup Frame -->
  <rect x="30" y="30" width="1140" height="690" rx="16" fill="#0b1120" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
  
  <!-- Window Header Bar -->
  <rect x="30" y="30" width="1140" height="48" rx="16" fill="#131c31" />
  <rect x="30" y="62" width="1140" height="16" fill="#131c31" />
  <line x1="30" y1="78" x2="1170" y2="78" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
  
  <!-- Window Traffic Lights -->
  <circle cx="60" cy="54" r="6" fill="#ef4444" />
  <circle cx="80" cy="54" r="6" fill="#f59e0b" />
  <circle cx="100" cy="54" r="6" fill="#10b981" />

  <!-- URL Bar -->
  <rect x="140" y="42" width="460" height="24" rx="6" fill="#0b1120" stroke="rgba(255,255,255,0.08)" />
  <text x="160" y="58" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11" font-weight="500">https://ai-business-operations-copilot.streamlit.app/</text>

  <!-- Title & Badge in Header -->
  <rect x="980" y="42" width="160" height="24" rx="12" fill="#2563eb20" stroke="#2563eb60" />
  <text x="1060" y="58" fill="#2563eb" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">Fintech OCR</text>

  <!-- Main Content Area -->
  <g transform="translate(60, 105)">
    <!-- Sidebar -->
    <rect x="0" y="0" width="220" height="580" rx="12" fill="#0e1628" stroke="rgba(255,255,255,0.06)" />
    <text x="20" y="35" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="15" font-weight="bold">StatementIQ</text>
    <text x="20" y="55" fill="#64748b" font-family="system-ui, sans-serif" font-size="11">Transaction Classifier</text>

    <rect x="15" y="80" width="190" height="32" rx="8" fill="#2563eb25" stroke="#2563eb50" />
    <text x="35" y="101" fill="#2563eb" font-family="system-ui, sans-serif" font-size="12" font-weight="600">● 1. Ingestion Pipeline</text>

    <rect x="15" y="125" width="190" height="32" rx="8" fill="#1e293b50" />
    <text x="35" y="146" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">● 2. 4-Agent Chat Studio</text>

    <rect x="15" y="170" width="190" height="32" rx="8" fill="#1e293b50" />
    <text x="35" y="191" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">● 3. Vector Evaluation</text>

    <!-- Sidebar Bottom Status -->
    <rect x="15" y="490" width="190" height="70" rx="8" fill="#131c31" stroke="rgba(255,255,255,0.06)" />
    <text x="25" y="515" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">FAISS Index: Active</text>
    <text x="25" y="535" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">Chunks: 1,420 vectors</text>
    <text x="25" y="550" fill="#2563eb" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">Latency: 142 ms</text>

    <!-- Main Canvas Area -->
    <g transform="translate(245, 0)">
      
  <rect x="0" y="0" width="830" height="580" rx="12" fill="#0e1628" stroke="rgba(255,255,255,0.06)" />
  <text x="30" y="45" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="18" font-weight="bold">StatementIQ &bull; Bank Statement Transaction Classifier</text>
  <text x="30" y="70" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">Automated tabular OCR parsing, category clustering &amp; cash reconciliation</text>

  <!-- Metric Cards -->
  <rect x="30" y="95" width="240" height="95" rx="10" fill="#131c31" stroke="#2563eb40" />
  <text x="50" y="130" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="24" font-weight="bold">₹ 4,82,450</text>
  <text x="50" y="155" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">Total Debits Analyzed</text>

  <rect x="295" y="95" width="240" height="95" rx="10" fill="#131c31" stroke="#10b98140" />
  <text x="315" y="130" fill="#34d399" font-family="system-ui, sans-serif" font-size="24" font-weight="bold">95.4%</text>
  <text x="315" y="155" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">Classification Accuracy</text>

  <rect x="560" y="95" width="240" height="95" rx="10" fill="#131c31" stroke="#f59e0b40" />
  <text x="580" y="130" fill="#f59e0b" font-family="system-ui, sans-serif" font-size="24" font-weight="bold">18 Buckets</text>
  <text x="580" y="155" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">Standardized Accounting</text>

  <!-- Table View -->
  <rect x="30" y="210" width="770" height="320" rx="10" fill="#131c31" stroke="rgba(255,255,255,0.08)" />
  <text x="50" y="240" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Transaction Narration</text>
  <text x="350" y="240" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Amount</text>
  <text x="490" y="240" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Predicted Category</text>
  <text x="690" y="240" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Confidence</text>
  <line x1="30" y1="255" x2="800" y2="255" stroke="rgba(255,255,255,0.08)" />

  <text x="50" y="285" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">UPI/4128/AMZN MKTPLACE/REF8291</text>
  <text x="350" y="285" fill="#ef4444" font-family="system-ui, sans-serif" font-size="12">- ₹ 2,499</text>
  <text x="490" y="285" fill="#f59e0b" font-family="system-ui, sans-serif" font-size="12">Office Equipment</text>
  <text x="690" y="285" fill="#10b981" font-family="system-ui, sans-serif" font-size="12">99.1%</text>

  <text x="50" y="325" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">NEFT/HDFC0012/CLIENT_RETAINER</text>
  <text x="350" y="325" fill="#10b981" font-family="system-ui, sans-serif" font-size="12">+ ₹ 1,25,000</text>
  <text x="490" y="325" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="12">Professional Fees</text>
  <text x="690" y="325" fill="#10b981" font-family="system-ui, sans-serif" font-size="12">98.4%</text>

  <text x="50" y="365" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">ACH/AWS CLOUD/BILL_DEC2025</text>
  <text x="350" y="365" fill="#ef4444" font-family="system-ui, sans-serif" font-size="12">- ₹ 14,820</text>
  <text x="490" y="365" fill="#c084fc" font-family="system-ui, sans-serif" font-size="12">Cloud Infrastructure</text>
  <text x="690" y="365" fill="#10b981" font-family="system-ui, sans-serif" font-size="12">99.8%</text>

  <text x="50" y="405" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">IMPS/SWIGGY_INSTAMART/FOOD</text>
  <text x="350" y="405" fill="#ef4444" font-family="system-ui, sans-serif" font-size="12">- ₹ 680</text>
  <text x="490" y="405" fill="#ec4899" font-family="system-ui, sans-serif" font-size="12">Team Refreshments</text>
  <text x="690" y="405" fill="#10b981" font-family="system-ui, sans-serif" font-size="12">97.6%</text>

    </g>
  </g>
</svg>