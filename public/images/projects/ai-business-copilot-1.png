<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 750" width="1200" height="750">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0.8" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)" />
  <rect width="100%" height="100%" fill="url(#grid)" />

  <!-- Browser Window Mockup Frame -->
  <rect x="30" y="30" width="1140" height="690" rx="16" fill="#0b1120" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
  
  <!-- Window Header Bar -->
  <rect x="30" y="30" width="1140" height="48" rx="16" fill="#131c31" />
  <rect x="30" y="62" width="1140" height="16" fill="#131c31" />
  <line x1="30" y1="78" x2="1170" y2="78" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
  
  <!-- Window Traffic Lights -->
  <circle cx="60" cy="54" r="6" fill="#ef4444" />
  <circle cx="80" cy="54" r="6" fill="#f59e0b" />
  <circle cx="100" cy="54" r="6" fill="#10b981" />

  <!-- URL Bar -->
  <rect x="140" y="42" width="460" height="24" rx="6" fill="#0b1120" stroke="rgba(255,255,255,0.08)" />
  <text x="160" y="58" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11" font-weight="500">https://ai-business-operations-copilot.streamlit.app/</text>

  <!-- Title & Badge in Header -->
  <rect x="980" y="42" width="160" height="24" rx="12" fill="#6366f120" stroke="#6366f160" />
  <text x="1060" y="58" fill="#6366f1" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">Sequential RAG</text>

  <!-- Main Content Area -->
  <g transform="translate(60, 105)">
    <!-- Sidebar -->
    <rect x="0" y="0" width="220" height="580" rx="12" fill="#0e1628" stroke="rgba(255,255,255,0.06)" />
    <text x="20" y="35" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="15" font-weight="bold">Copilot RAG</text>
    <text x="20" y="55" fill="#64748b" font-family="system-ui, sans-serif" font-size="11">Multi-Agent Studio</text>

    <rect x="15" y="80" width="190" height="32" rx="8" fill="#6366f125" stroke="#6366f150" />
    <text x="35" y="101" fill="#6366f1" font-family="system-ui, sans-serif" font-size="12" font-weight="600">● 1. Ingestion Pipeline</text>

    <rect x="15" y="125" width="190" height="32" rx="8" fill="#1e293b50" />
    <text x="35" y="146" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">● 2. 4-Agent Chat Studio</text>

    <rect x="15" y="170" width="190" height="32" rx="8" fill="#1e293b50" />
    <text x="35" y="191" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">● 3. Vector Evaluation</text>

    <!-- Sidebar Bottom Status -->
    <rect x="15" y="490" width="190" height="70" rx="8" fill="#131c31" stroke="rgba(255,255,255,0.06)" />
    <text x="25" y="515" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">FAISS Index: Active</text>
    <text x="25" y="535" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">Chunks: 1,420 vectors</text>
    <text x="25" y="550" fill="#6366f1" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">Latency: 142 ms</text>

    <!-- Main Canvas Area -->
    <g transform="translate(245, 0)">
      
  <rect x="0" y="0" width="830" height="580" rx="12" fill="#0e1628" stroke="rgba(255,255,255,0.06)" />
  
  <!-- 4 Agents Status Pipeline -->
  <rect x="25" y="25" width="780" height="75" rx="10" fill="#131c31" stroke="rgba(255,255,255,0.08)" />
  
  <g transform="translate(45, 45)">
    <circle cx="20" cy="18" r="16" fill="#6366f130" stroke="#6366f1" stroke-width="2" />
    <text x="20" y="23" fill="#818cf8" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">1</text>
    <text x="50" y="15" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Planner</text>
    <text x="50" y="30" fill="#22c55e" font-family="system-ui, sans-serif" font-size="10">Decomposed Query</text>
  </g>

  <g transform="translate(235, 45)">
    <circle cx="20" cy="18" r="16" fill="#06b6d430" stroke="#06b6d4" stroke-width="2" />
    <text x="20" y="23" fill="#22d3ee" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">2</text>
    <text x="50" y="15" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Researcher</text>
    <text x="50" y="30" fill="#22d3ee" font-family="system-ui, sans-serif" font-size="10">Top-k FAISS Retrieval</text>
  </g>

  <g transform="translate(425, 45)">
    <circle cx="20" cy="18" r="16" fill="#a855f730" stroke="#a855f7" stroke-width="2" />
    <text x="20" y="23" fill="#c084fc" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">3</text>
    <text x="50" y="15" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Executor</text>
    <text x="50" y="30" fill="#a855f7" font-family="system-ui, sans-serif" font-size="10">Llama 3 Synthesis</text>
  </g>

  <g transform="translate(615, 45)">
    <circle cx="20" cy="18" r="16" fill="#10b98130" stroke="#10b981" stroke-width="2" />
    <text x="20" y="23" fill="#34d399" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">4</text>
    <text x="50" y="15" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Reviewer</text>
    <text x="50" y="30" fill="#10b981" font-family="system-ui, sans-serif" font-size="10">Confidence: 99.2%</text>
  </g>

  <!-- Query Box -->
  <rect x="25" y="125" width="780" height="95" rx="10" fill="#1e293b40" stroke="#6366f140" />
  <text x="45" y="155" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" letter-spacing="1">USER QUERY</text>
  <text x="45" y="185" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="14" font-weight="500">"What are our maternity leave entitlements and travel expense reimbursement limits according to the Q1 SOP?"</text>

  <!-- Grounded Response Card -->
  <rect x="25" y="240" width="780" height="300" rx="10" fill="#131c31" stroke="rgba(255,255,255,0.08)" />
  <rect x="25" y="240" width="780" height="36" rx="10" fill="#1e293b70" />
  <text x="45" y="263" fill="#22d3ee" font-family="system-ui, sans-serif" font-size="12" font-weight="bold">Grounded Synthesis &bull; Citations Verified</text>
  <text x="710" y="263" fill="#10b981" font-family="system-ui, sans-serif" font-size="11" font-weight="bold">Latency: 182ms</text>

  <text x="45" y="310" fill="#cbd5e1" font-family="system-ui, sans-serif" font-size="13" font-weight="500">Based strictly on internal document [hr_policy.txt#Section-4.2] and [sop_customer_support.txt]:</text>
  <text x="45" y="340" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="13">1. Maternity Leave: 26 weeks of paid leave are provided for first two children, with optional 4-week extension.</text>
  <text x="45" y="370" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="13">2. Travel Expense Limit: Domestic client visits are capped at $250/day including lodging and meal vouchers.</text>
  <text x="45" y="400" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="13">3. Verification: Reviewer Agent calculated 0.00% hallucination risk against vector index hash.</text>

  <!-- Citation Chips -->
  <rect x="45" y="450" width="180" height="30" rx="6" fill="#06b6d415" stroke="#06b6d440" />
  <text x="60" y="470" fill="#22d3ee" font-family="system-ui, sans-serif" font-size="11">📄 hr_policy.txt (98% match)</text>

  <rect x="240" y="450" width="200" height="30" rx="6" fill="#a855f715" stroke="#a855f740" />
  <text x="255" y="470" fill="#c084fc" font-family="system-ui, sans-serif" font-size="11">📄 financial_report_q1.txt (94%)</text>

    </g>
  </g>
</svg>