<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 750" width="1200" height="750">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0.8" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <rect width="100%" height="100%" fill="url(#bg)" />
  <rect width="100%" height="100%" fill="url(#grid)" />

  <!-- Browser Window Mockup Frame -->
  <rect x="30" y="30" width="1140" height="690" rx="16" fill="#0b1120" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
  
  <!-- Window Header Bar -->
  <rect x="30" y="30" width="1140" height="48" rx="16" fill="#131c31" />
  <rect x="30" y="62" width="1140" height="16" fill="#131c31" />
  <line x1="30" y1="78" x2="1170" y2="78" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
  
  <!-- Window Traffic Lights -->
  <circle cx="60" cy="54" r="6" fill="#ef4444" />
  <circle cx="80" cy="54" r="6" fill="#f59e0b" />
  <circle cx="100" cy="54" r="6" fill="#10b981" />

  <!-- URL Bar -->
  <rect x="140" y="42" width="460" height="24" rx="6" fill="#0b1120" stroke="rgba(255,255,255,0.08)" />
  <text x="160" y="58" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11" font-weight="500">https://ai-business-operations-copilot.streamlit.app/</text>

  <!-- Title & Badge in Header -->
  <rect x="980" y="42" width="160" height="24" rx="12" fill="#38bdf820" stroke="#38bdf860" />
  <text x="1060" y="58" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">Accounting Sync</text>

  <!-- Main Content Area -->
  <g transform="translate(60, 105)">
    <!-- Sidebar -->
    <rect x="0" y="0" width="220" height="580" rx="12" fill="#0e1628" stroke="rgba(255,255,255,0.06)" />
    <text x="20" y="35" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="15" font-weight="bold">StatementIQ Audit</text>
    <text x="20" y="55" fill="#64748b" font-family="system-ui, sans-serif" font-size="11">Reconciliation</text>

    <rect x="15" y="80" width="190" height="32" rx="8" fill="#38bdf825" stroke="#38bdf850" />
    <text x="35" y="101" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="12" font-weight="600">● 1. Ingestion Pipeline</text>

    <rect x="15" y="125" width="190" height="32" rx="8" fill="#1e293b50" />
    <text x="35" y="146" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">● 2. 4-Agent Chat Studio</text>

    <rect x="15" y="170" width="190" height="32" rx="8" fill="#1e293b50" />
    <text x="35" y="191" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">● 3. Vector Evaluation</text>

    <!-- Sidebar Bottom Status -->
    <rect x="15" y="490" width="190" height="70" rx="8" fill="#131c31" stroke="rgba(255,255,255,0.06)" />
    <text x="25" y="515" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">FAISS Index: Active</text>
    <text x="25" y="535" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="11">Chunks: 1,420 vectors</text>
    <text x="25" y="550" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="10" font-weight="bold">Latency: 142 ms</text>

    <!-- Main Canvas Area -->
    <g transform="translate(245, 0)">
      
  <rect x="0" y="0" width="830" height="580" rx="12" fill="#0e1628" stroke="rgba(255,255,255,0.06)" />
  <text x="30" y="45" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="18" font-weight="bold">Reconciliation Breakdown &amp; Spending Distribution</text>
  <text x="30" y="70" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="12">Auto-reconciles bank PDF statements with company general ledger accounts</text>

  <rect x="30" y="105" width="770" height="420" rx="10" fill="#131c31" stroke="rgba(255,255,255,0.08)" />
  
  <text x="50" y="150" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="14" font-weight="bold">Category Distribution (18 Standardized Buckets)</text>

  <!-- Distribution Bars -->
  <text x="50" y="195" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">Cloud Infrastructure (34%)</text>
  <rect x="50" y="205" width="700" height="14" rx="7" fill="#1e293b" />
  <rect x="50" y="205" width="240" height="14" rx="7" fill="#38bdf8" />

  <text x="50" y="255" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">Consultant &amp; Professional Fees (28%)</text>
  <rect x="50" y="265" width="700" height="14" rx="7" fill="#1e293b" />
  <rect x="50" y="265" width="195" height="14" rx="7" fill="#818cf8" />

  <text x="50" y="315" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">Software Licenses &amp; SaaS (22%)</text>
  <rect x="50" y="325" width="700" height="14" rx="7" fill="#1e293b" />
  <rect x="50" y="325" width="154" height="14" rx="7" fill="#a855f7" />

  <text x="50" y="375" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="12">Travel &amp; Logistics (16%)</text>
  <rect x="50" y="385" width="700" height="14" rx="7" fill="#1e293b" />
  <rect x="50" y="385" width="112" height="14" rx="7" fill="#f59e0b" />

  <text x="50" y="450" fill="#10b981" font-family="system-ui, sans-serif" font-size="16" font-weight="bold">Reconciliation Status: 100% Balanced &bull; 0 Unmatched Journal Items</text>

    </g>
  </g>
</svg>